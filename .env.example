# Copy this file to .env.local and fill in the values.
# Never commit .env.local – it is in .gitignore.

# ---- App -----------------------------------------------------------------
# "true" = fictional demo dataset. "false" = live OpenStreetMap search (or Google Places if set).
NEXT_PUBLIC_DEMO_MODE=false

# Contact email sent to OpenStreetMap Nominatim (their usage policy).
CONTACT_EMAIL=

# ---- Admin login (server-only) --------------------------------------------
# Comma-separated emails that may sign in. Password is shared.
AUTH_ALLOWED_EMAILS=
AUTH_PASSWORD=
# Random string, at least 16 characters. Used to sign the session cookie.
AUTH_SECRET=

# ---- Supabase (Phase 2) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Business data provider (Phase 3) – server-only ------------------------
# Geoapify Places is used when this is set. It does not include Google ratings.
GEOAPIFY_API_KEY=
GOOGLE_PLACES_API_KEY=

# ---- Website analyzer (Phase 4) – server-only ------------------------------
PAGESPEED_API_KEY=
SCREENSHOT_API_KEY=

# ---- AI provider (Phase 7) – server-only -----------------------------------
OPENAI_API_KEY=
